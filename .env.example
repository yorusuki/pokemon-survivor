# 複製為 .env，填入隨機長密碼。請勿提交 .env。
POSTGRES_PASSWORD=
# API 的受限資料庫帳號密碼：獨立隨機 32 字元以上，不能與初始化密碼共用。
APP_DATABASE_PASSWORD=
# Nginx → API 的內部驗證 secret：隨機 32～128 個英數字／底線／連字號。
API_PROXY_SECRET=
# cloudflared 子網由 web 啟動時自動辨認，不需固定 connector IP。
TURN_CREDENTIALS_PER_HOUR=300
REGISTRATIONS_PER_HOUR=100
# 公開 HTTPS 網址，不含尾斜線；範例網域為佔位值，部署前必須替換。
APP_ORIGIN=https://game.example.com
HTTP_PORT=8080
# Cloudflare Realtime TURN 憑證僅供後端使用；兩項皆空時明確使用 STUN 模式。
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# 註冊後的使用者 UID，以逗號分隔；預設沒有管理員。
ADMIN_USER_IDS=
# 僅 compose.static-ip.yaml 使用，必須先查詢既有網路的 IPAM。
CFT_IPV4=

# Google OAuth：兩項皆空時隱藏 Google 登入；只填一項會拒絕啟動。
# 使用自己的 GCP Web application OAuth client；secret 僅傳給 API。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://game.example.com/api/auth/google/callback
# Tunnel token 屬於既有 cloudflared connector，不放入遊戲/API 容器。

# 活動機率：true 套用活動值；false 恢復原機率。更改後重建 API，玩家重新整理。
GAME_EVENT_BOOST_ENABLED=false
